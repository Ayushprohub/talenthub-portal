{
  "version": 2,
  "name": "talenthub-backend",
  "builds": [
    {
      "src": "job-listing-portal/backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/job-listing-portal/backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/job-listing-portal/backend/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "job-listing-portal/backend/server.js": {
      "maxDuration": 30
    }
  }
}